# ── CiteGuard Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.

# Optional: Semantic Scholar API key (higher rate limit)
# Get one at https://www.semanticscholar.org/product/api
S2_API_KEY=

# Embedding model (swap to IBM Slate for watsonx)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2
# EMBEDDING_MODEL=ibm-granite/granite-embedding-278m-multilingual

# NLI model
# NLI_MODEL=cross-encoder/nli-deberta-v3-large

# Retrieval settings
TOP_K_RETRIEVAL=50
TOP_K_RERANK=10
NLI_THRESHOLD=0.5

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
